{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All",
  "version": "0.4.0",
  "identifier": "com.indkhan.all",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "All",
        "width": 760,
        "height": 700,
        "minWidth": 560,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRTY3QjQyNzY3N0E5NkIKUldScnFYZDJRbnZtNjdCVGJiVER1VUsrQ2RLcEFXTStJdGoxTlovcEs3U1l5ZTVwdjBCNlZ1NUEK",
      "endpoints": [
        "https://github.com/indkhan/allrandom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}